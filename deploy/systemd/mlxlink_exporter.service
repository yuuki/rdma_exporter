[Unit]
Description=Prometheus mlxlink Exporter
Documentation=https://github.com/yuuki/rdma_exporter
Wants=network-online.target
After=network-online.target

[Service]
# mlxlink reaches the adapter through the MFT firmware interface, so the
# privileges it needs depend on the host: MFT packaging, the ownership of the
# /dev/mst devices and the kernel lockdown state all differ between machines.
# This unit therefore starts unprivileged and fully hardened, and does NOT
# assume root. Verify on the target host before granting anything:
#
#   1. start as configured here
#   2. curl -s localhost:9880/metrics | grep mlxlink_collection_errors_total
#   3. if reason="permission_denied" (or exit_error with a permission message
#      in the logs) appears, relax the smallest thing that fixes it, typically
#      device ownership, then CapabilityBoundingSet, then User=
#
# See docs/deployment.md for the full procedure.
User=mlxlink_exporter
Group=mlxlink_exporter
# Configuration lives in the environment file, not in ExecStart: systemd does
# not run ExecStart through a shell and only expands $VAR / ${VAR}, so shell
# style defaults such as ${VAR:-value} would fail to start the service. Every
# flag has an environment counterpart and a built-in default, so an empty file
# is a valid configuration. Example /etc/mlxlink_exporter.env:
#
#   MLXLINK_EXPORTER_LISTEN_ADDRESS=:9880
#   MLXLINK_EXPORTER_METRICS_PATH=/metrics
#   MLXLINK_EXPORTER_HEALTH_PATH=/healthz
#   MLXLINK_EXPORTER_READY_PATH=/readyz
#   MLXLINK_EXPORTER_LOG_LEVEL=info
#   MLXLINK_EXPORTER_MLXLINK_PATH=/usr/bin/mlxlink
#   MLXLINK_EXPORTER_SYSFS_ROOT=/sys
#   MLXLINK_EXPORTER_POLL_INTERVAL=30s
#   MLXLINK_EXPORTER_COMMAND_TIMEOUT=3s
#   MLXLINK_EXPORTER_EXCLUDE_DEVICES=
EnvironmentFile=-/etc/mlxlink_exporter.env
ExecStart=/usr/local/bin/mlxlink_exporter
Restart=on-failure
RestartSec=5s
StateDirectory=mlxlink_exporter
RuntimeDirectory=mlxlink_exporter
WorkingDirectory=/var/lib/mlxlink_exporter
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
