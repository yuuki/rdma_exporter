# Optional mlx5 congestion-control counters only (default exporter settings).
# RDMA_OPTIONAL_COUNTERS=cc_rx_ce_pkts,cc_rx_cnp_pkts,cc_tx_cnp_pkts

# QP auto-type counters for rdma_exporter --collector.qp-counters.
# Extends the optional-counter set with rdma_{rx,tx}_{bytes,packets} and
# runs rdma statistic qp set link ... auto type on optional-counters on.
# RDMA_ENABLE_QP_COUNTERS=1
